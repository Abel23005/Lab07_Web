<%- include('../partials/header') %>
<div class="row valign-wrapper" style="min-height:calc(100vh - 220px);">
  <div class="col s12 m10 offset-m1 l6 offset-l3 xl4 offset-xl4">
    <div class="card auth-card hoverable">
      <div class="card-content">
        <div class="auth-badge"><i class="material-icons tiny">verified_user</i> Acceso seguro</div>
        <span class="card-title">Iniciar sesión</span>
        <p class="auth-lead">
          Introduce tu correo y contraseña. El token <strong>JWT</strong> se guardará en el almacenamiento de sesión del navegador (<strong>sessionStorage</strong>) para las siguientes peticiones.
        </p>
        <form id="sign-in-form">
          <div class="input-field">
            <i class="material-icons prefix teal-text text-darken-2">mail_outline</i>
            <input id="email" type="email" class="validate" required autocomplete="username" placeholder=" ">
            <label for="email">Correo electrónico</label>
          </div>
          <div class="input-field">
            <i class="material-icons prefix teal-text text-darken-2">lock_outline</i>
            <input id="password" type="password" class="validate" required autocomplete="current-password" placeholder=" ">
            <label for="password">Contraseña</label>
          </div>
          <button class="btn waves-effect waves-light btn-app btn-large width-100" style="width:100%;margin-top:8px;" type="submit">
            Entrar <i class="material-icons right">arrow_forward</i>
          </button>
        </form>
        <div class="auth-links center-align">
          ¿No tienes cuenta?
          <a href="/signup" class="teal-text text-darken-2">Crear cuenta</a>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('sign-in-form');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = document.getElementById('email').value.trim();
      var password = document.getElementById('password').value;
      try {
        var res = await fetch('/api/auth/signIn', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, password: password })
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok) {
          if (typeof M !== 'undefined') M.toast({ html: data.message || 'No se pudo iniciar sesión' });
          return;
        }
        AuthLab.setToken(data.token);
        var payload = AuthLab.parsePayload(data.token);
        var roles = (payload && payload.roles) || [];
        if (roles.indexOf('admin') !== -1) window.location.href = '/dashboard/admin';
        else window.location.href = '/dashboard/user';
      } catch (err) {
        if (typeof M !== 'undefined') M.toast({ html: 'Error de red. Inténtalo de nuevo.' });
      }
    });
  });
</script>
<%- include('../partials/footer') %>
