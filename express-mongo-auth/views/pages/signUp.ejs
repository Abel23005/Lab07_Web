<%- include('../partials/header') %>
<div class="row">
  <div class="col s12 m10 offset-m1 l8 offset-l2">
    <div class="card auth-card hoverable">
      <div class="card-content">
        <div class="auth-badge"><i class="material-icons tiny">person_add</i> Registro</div>
        <span class="card-title">Crear cuenta</span>
        <p class="auth-lead">
          Se asignará el rol <strong>usuario</strong> por defecto. La contraseña debe tener al menos <strong>8 caracteres</strong>, una <strong>mayúscula</strong>, un <strong>dígito</strong> y un carácter especial entre: <strong># $ % &amp; * @</strong>.
        </p>
        <form id="sign-up-form">
          <div class="row">
            <div class="input-field col s12 m6">
              <i class="material-icons prefix teal-text text-darken-2">badge</i>
              <input id="name" type="text" required placeholder=" ">
              <label for="name">Nombre</label>
            </div>
            <div class="input-field col s12 m6">
              <i class="material-icons prefix teal-text text-darken-2">person</i>
              <input id="lastName" type="text" required placeholder=" ">
              <label for="lastName">Apellido</label>
            </div>
          </div>
          <div class="row">
            <div class="input-field col s12 m6">
              <i class="material-icons prefix teal-text text-darken-2">phone</i>
              <input id="phoneNumber" type="text" required placeholder=" ">
              <label for="phoneNumber">Teléfono</label>
            </div>
            <div class="input-field col s12 m6">
              <i class="material-icons prefix teal-text text-darken-2">cake</i>
              <input id="birthdate" type="date" class="validate" required>
              <label for="birthdate" class="active">Fecha de nacimiento</label>
            </div>
          </div>
          <div class="input-field">
            <i class="material-icons prefix teal-text text-darken-2">mail_outline</i>
            <input id="email" type="email" class="validate" required autocomplete="username" placeholder=" ">
            <label for="email">Correo electrónico</label>
          </div>
          <div class="input-field">
            <i class="material-icons prefix teal-text text-darken-2">lock_outline</i>
            <input id="password" type="password" class="validate" required autocomplete="new-password" placeholder=" ">
            <label for="password">Contraseña</label>
          </div>
          <button class="btn waves-effect waves-light btn-app btn-large" style="width:100%;margin-top:8px;" type="submit">
            Registrarme <i class="material-icons right">check_circle</i>
          </button>
        </form>
        <div class="auth-links center-align">
          ¿Ya tienes cuenta?
          <a href="/signin" class="teal-text text-darken-2">Iniciar sesión</a>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('sign-up-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      var body = {
        name: document.getElementById('name').value.trim(),
        lastName: document.getElementById('lastName').value.trim(),
        phoneNumber: document.getElementById('phoneNumber').value.trim(),
        birthdate: document.getElementById('birthdate').value,
        email: document.getElementById('email').value.trim(),
        password: document.getElementById('password').value
      };
      try {
        var res = await fetch('/api/auth/signUp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok) {
          if (typeof M !== 'undefined') M.toast({ html: data.message || 'No se pudo completar el registro' });
          return;
        }
        if (typeof M !== 'undefined') M.toast({ html: '¡Registro correcto! Ahora inicia sesión.' });
        window.location.href = '/signin';
      } catch (err) {
        if (typeof M !== 'undefined') M.toast({ html: 'Error de red. Inténtalo de nuevo.' });
      }
    });
  });
</script>
<%- include('../partials/footer') %>
